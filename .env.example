# Переменные окружения для PlanMeBot
# Скопируйте этот файл в .env и вставьте ваши реальные токены

# Telegram Bot Token (получите от @BotFather)
BOT_TOKEN=your_telegram_bot_token_here

# OpenWeather API Key (получите на https://openweathermap.org/api)
WEATHER_API_KEY=your_openweather_api_key_here

# Для будущих интеграций:
# GEMINI_API_KEY=your_gemini_api_key_here
# GOOGLE_CALENDAR_CLIENT_ID=your_google_client_id_here
# NOTION_TOKEN=your_notion_integration_token_here
